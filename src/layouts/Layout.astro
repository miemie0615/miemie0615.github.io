---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import Live2D from "@/components/Live2D.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site, features } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
);
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="icon" type="image/svg" href={getAssetPath("favicon.svg")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: "300 800", style: "normal" }]}
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");

        // 同步应用国风配色（data-palette），避免刷新时先闪默认色再变。
        const palette = localStorage.getItem("palette") ?? "";
        if (palette) {
          root?.setAttribute("data-palette", palette);
        } else {
          root?.removeAttribute("data-palette");
        }

        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme, palette: palette };
      })();
    </script>

    <ClientRouter />

    <!-- Analytics: 根据配置加载对应统计脚本 -->
    {
      features.analytics && (
        features.analytics.provider === "busuanzi" ? (
          // 不蒜子：零配置，按域名自动统计 PV/UV
          // pure 版本仅显示计数；完整版本自动追踪 SPA 页面切换
          <>
            <!--
              不蒜子核心脚本 (async 异步加载，不阻塞页面渲染)
              使用 referrerpolicy="no-referrer" 防止因 Referer 被拦截
              crossorigin="anonymous" 允许跨域资源加载
            -->
            <script
              is:inline
              src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"
              async
              defer
              crossorigin="anonymous"
              referrerpolicy="no-referrer"
            ></script>

            <!--
              不蒜子健康检查 + 自动恢复脚本
              ------------------------------------------------------------
              功能：
              1. 检测不蒜子脚本是否成功加载并注入数据到 DOM
              2. 服务不可用时维持 "loading" 状态，显示 "--" 占位符，不报错不跳布局
              3. 超时(6s)后标记为 "offline" 状态，数字区域显示轻量虚线样式
              4. 每 30s 轮询重试，服务恢复后自动更新为真实数字
              5. SPA 页面切换时重新触发检测
              6. 网络恢复事件 (online) 立即触发重试
            -->
            <script is:inline data-busuanzi-watchdog>
              (function () {
                "use strict";

                // 配置参数
                var LOAD_TIMEOUT = 6000;      // 首次加载超时时间 (ms)
                var RETRY_INTERVAL = 30000;   // 服务恢复轮询间隔 (ms)
                var CHECK_INTERVAL = 500;      // 加载中轮询检测间隔 (ms)
                var MAX_CHECK_ATTEMPTS = LOAD_TIMEOUT / CHECK_INTERVAL;

                var uvEl = null;
                var pvEl = null;
                var container = null;
                var checkCount = 0;
                var watchdogTimer = null;
                var retryTimer = null;
                var isOffline = false;

                /**
                 * 获取统计数字 DOM 元素
                 */
                function getElements() {
                  if (!container) {
                    container = document.querySelector("[data-busuanzi-stats]");
                  }
                  if (!uvEl) {
                    uvEl = document.getElementById("busuanzi_value_site_uv");
                  }
                  if (!pvEl) {
                    pvEl = document.getElementById("busuanzi_value_site_pv");
                  }
                  return container && uvEl && pvEl;
                }

                /**
                 * 检查不蒜子是否已成功注入真实数据
                 * 判断标准：元素文本不为空、不为 "--"、且不全为 0（排除新站点刚启用的情况）
                 */
                function hasRealData() {
                  if (!getElements()) return false;
                  var uv = (uvEl.textContent || "").trim();
                  var pv = (pvEl.textContent || "").trim();
                  // 不蒜子注入的数字为纯数字字符串，至少 1 位
                  // 新站点可能显示 "0"，这是有效的真实数据
                  return /^\d+$/.test(uv) && /^\d+$/.test(pv);
                }

                /**
                 * 从旧版不蒜子脚本获取数据
                 * 如果 pure 版本脚本未自动注入，尝试手动请求 API
                 */
                function tryManualFetch() {
                  // 不蒜子 API：获取站点统计
                  var apiUrl = "https://busuanzi.ibruce.info/v2?site=" +
                    encodeURIComponent(window.location.hostname);

                  fetch(apiUrl, {
                    method: "GET",
                    mode: "cors",
                    referrerPolicy: "no-referrer",
                    headers: { "Accept": "application/json" }
                  })
                    .then(function (res) {
                      if (!res.ok) throw new Error("HTTP " + res.status);
                      return res.json();
                    })
                    .then(function (data) {
                      if (data && data.success && data.data) {
                        var d = data.data;
                        if (d.uv && uvEl) uvEl.textContent = String(d.uv);
                        if (d.pv && pvEl) pvEl.textContent = String(d.pv);
                        markReady();
                      }
                    })
                    .catch(function () {
                      // 静默失败，不触发错误
                    });
                }

                /**
                 * 把不蒜子注入的纯数字文本拆成单个 t-digit span，
                 * 最后两位加 data-stagger 做错峰翻牌动画。
                 */
                function splitDigits(el) {
                  var text = (el.textContent || "").trim();
                  if (!/^\d+$/.test(text)) return; // 非纯数字不处理
                  el.classList.remove("is-animating");
                  el.innerHTML = "";
                  var chars = text.split("");
                  for (var i = 0; i < chars.length; i++) {
                    var span = document.createElement("span");
                    span.className = "t-digit";
                    span.textContent = chars[i];
                    // 最后两位加 stagger
                    if (i === chars.length - 2) span.setAttribute("data-stagger", "1");
                    else if (i === chars.length - 1) span.setAttribute("data-stagger", "2");
                    el.appendChild(span);
                  }
                  // 强制 reflow 再启动动画
                  void el.offsetWidth;
                  el.classList.add("is-animating");
                }

                /**
                 * 标记为就绪状态：真实数据已显示
                 */
                function markReady() {
                  if (!container) return;
                  container.setAttribute("data-status", "ready");
                  isOffline = false;
                  stopWatchdog();
                  stopRetry();
                  // 给 UV/PV 数字做翻牌动画
                  if (uvEl) splitDigits(uvEl);
                  if (pvEl) splitDigits(pvEl);
                }

                /**
                 * 标记为离线状态：服务不可用
                 */
                function markOffline() {
                  if (!container) return;
                  container.setAttribute("data-status", "offline");
                  isOffline = true;
                  stopWatchdog();
                  // 启动定期重试
                  startRetry();
                }

                /**
                 * 标记为加载中状态
                 */
                function markLoading() {
                  if (!container) return;
                  container.setAttribute("data-status", "loading");
                }

                /**
                 * 启动 watchdog 轮询检测
                 */
                function startWatchdog() {
                  stopWatchdog();
                  checkCount = 0;
                  markLoading();

                  watchdogTimer = setInterval(function () {
                    checkCount++;

                    // 先检查不蒜子 pure 版本是否已自动注入
                    if (hasRealData()) {
                      // 不蒜子已注入数据，检查是否全为 0（新站点有效数据）
                      markReady();
                      return;
                    }

                    // 超时判断
                    if (checkCount >= MAX_CHECK_ATTEMPTS) {
                      // 尝试手动 fetch 一次作为备选
                      tryManualFetch();
                      // 短暂等待 manual fetch 结果
                      setTimeout(function () {
                        if (hasRealData()) {
                          markReady();
                        } else {
                          markOffline();
                        }
                      }, 1500);
                      stopWatchdog();
                      return;
                    }
                  }, CHECK_INTERVAL);
                }

                /**
                 * 停止 watchdog
                 */
                function stopWatchdog() {
                  if (watchdogTimer) {
                    clearInterval(watchdogTimer);
                    watchdogTimer = null;
                  }
                }

                /**
                 * 启动定期重试（仅在离线状态时）
                 */
                function startRetry() {
                  stopRetry();
                  retryTimer = setInterval(function () {
                    // 重新检查不蒜子脚本是否后来加载成功
                    if (hasRealData()) {
                      markReady();
                      return;
                    }
                    // 尝试手动 fetch
                    tryManualFetch();
                  }, RETRY_INTERVAL);
                }

                /**
                 * 停止重试
                 */
                function stopRetry() {
                  if (retryTimer) {
                    clearInterval(retryTimer);
                    retryTimer = null;
                  }
                }

                /**
                 * SPA 页面切换时重新检测
                 */
                function handlePageLoad() {
                  // 如果已有真实数据，不重新检测（避免闪烁）
                  if (hasRealData()) {
                    markReady();
                    return;
                  }
                  // 重新开始检测
                  startWatchdog();
                }

                /**
                 * 网络恢复时立即重试
                 */
                function handleOnline() {
                  if (isOffline) {
                    // 立即触发一次重试
                    if (hasRealData()) {
                      markReady();
                    } else {
                      tryManualFetch();
                      // 重新启动 watchdog 等待数据注入
                      startWatchdog();
                    }
                  }
                }

                /**
                 * 初始化：等待 DOM 就绪后启动检测
                 */
                function init() {
                  if (!getElements()) {
                    // DOM 可能还未就绪，稍后重试
                    setTimeout(init, 100);
                    return;
                  }

                  // 检查不蒜子脚本是否已在加载期间注入数据
                  if (hasRealData()) {
                    markReady();
                  } else {
                    startWatchdog();
                  }

                  // 注册 SPA 页面切换事件
                  document.addEventListener("astro:page-load", handlePageLoad);

                  // 注册网络恢复事件
                  window.addEventListener("online", handleOnline);
                }

                // DOMContentLoaded 后初始化
                if (document.readyState === "loading") {
                  document.addEventListener("DOMContentLoaded", init);
                } else {
                  init();
                }
              })();
            </script>
          </>
        ) : features.analytics.provider === "ga4" ? (
          // Google Analytics 4
          <>
            <script is:inline>
              (function () {
                var dnt = navigator.doNotTrack || window.doNotTrack;
                if (dnt === "1") return;
                window.dataLayer = window.dataLayer || [];
                window.gtag = function () {
                  window.dataLayer.push(arguments);
                };
                window.gtag("js", new Date());
                window.gtag("config", "{features.analytics.id}", {
                  anonymize_ip: true,
                  send_page_view: true,
                });
              })();
            </script>
            <script
              is:inline
              src="https://www.googletagmanager.com/gtag/js?id={features.analytics.id}"
              async
            ></script>
          </>
        ) : null
      )
    }
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <!-- 樱花飘落背景层：固定铺满视口，z-index:-1 位于正文内容之下，不遮挡文字 -->
    <div class="sakura-bg" id="sakuraBg" aria-hidden="true"></div>

    <slot />
    <Live2D />

    <!--
      点击飘字特效容器
      ------------------------------------------------------------
      每次点击时由 JS 动态注入"一间工作室"的下一个汉字。
      pointer-events: none 保证不拦截任何点击事件穿透到页面。
    -->
    <div class="char-trail" id="charTrail" aria-hidden="true"></div>

    <script>
      import "@/scripts/theme";
    </script>

    <!--
      点击飘字特效：点击一次出一个"一间工作室"汉字
      ------------------------------------------------------------
      动画节奏参考 CSDN setInterval 15ms/帧 原版实现：
      - 总时长 0.94s 线性匀速
      - 透明度从 1 线性递减到 0
      - 竖直向上飘 55~70px，水平 ±12px 随机摇摆
      - scale 从 1 微增到 1.3（原版每帧 +0.002 的递增）
      实现要点：
      1. 事件：document 上 click + touchend，覆盖桌面与触屏
      2. 循环：一→间→工→作→室 按顺序循环
      3. 防冲突：<a> <button> 等交互元素不触发
      4. 自动回收：0.94s 动画结束后 +160ms 余量清理 DOM
      5. SPA 兼容：astro:page-load 时清空残留
    -->
    <script is:inline data-click-pop>
      (function () {
        "use strict";

        // ===== 配置（数值参考 CSDN setInterval 15ms/帧 原版） =====
        // 每次点击飘出一个完整的"❤X❤"爱心包裹汉字，依次循环
        // ❤后加 \uFE0E（VS15 变体选择器）强制渲染为单色文本心形，
        // 使其能被 CSS color: var(--accent) 染色，不再是固定红色 emoji
        var HEART = "\u2764\uFE0E"; // ❤︎ 单色心形（可被 CSS 染色）
        var TEXT = [HEART + "一" + HEART, HEART + "间" + HEART, HEART + "工" + HEART, HEART + "作" + HEART, HEART + "室" + HEART];
        var MAX_PARTICLES = 30;     // 同屏最多粒子数
        var FLY_MIN = 55;           // 上飘距离下限(px)，对应原版 ~60px
        var FLY_MAX = 70;           // 上飘距离上限(px)
        var SWAY = 12;              // 水平随机摇摆范围(px)，原版无水平位移，加一点更灵动

        // ===== 状态 =====
        var container = null;
        var pendingCharIndex = 0;

        /** 随机数 */
        function rand(min, max) {
          return Math.random() * (max - min) + min;
        }

        /**
         * 随机颜色：与参考代码 randomColor() 完全一致
         * 每次点击生成随机 RGB，让每个飘字颜色都不同
         */
        function randomColor() {
          return "rgb(" +
            (~~(Math.random() * 255)) + "," +
            (~~(Math.random() * 255)) + "," +
            (~~(Math.random() * 255)) + ")";
        }

        /**
         * 从给定坐标飘出一个汉字
         */
        function emitChar(x, y) {
          if (!container) return;

          var char = TEXT[pendingCharIndex];
          pendingCharIndex = (pendingCharIndex + 1) % TEXT.length;

          var el = document.createElement("span");
          el.className = "char-trail__item";
          el.textContent = char;

          // 随机颜色：覆盖 CSS 默认的 var(--accent)
          el.style.color = randomColor();

          // 起点：点击位置，带轻微抖动（±4px）让落点不那么机械
          el.style.left = (x + rand(-4, 4)) + "px";
          el.style.top = (y + rand(-2, 2)) + "px";

          // 终点位移：竖直向上 55~70px，水平 ±SWAY 摇摆
          var dx = rand(-SWAY, SWAY);
          var dy = -rand(FLY_MIN, FLY_MAX); // 向上为负

          el.style.setProperty("--char-dx", dx + "px");
          el.style.setProperty("--char-dy", dy + "px");

          // 粒子过多时丢弃最早的（原版 setInterval 无此保护，这里做一下避免堆积）
          while (container.children.length >= MAX_PARTICLES) {
            container.removeChild(container.firstChild);
          }

          container.appendChild(el);

          // CSS 动画 0.94s 结束后清理（加 160ms 余量防止边界丢帧）
          setTimeout(function () {
            if (el.parentNode === container) {
              container.removeChild(el);
            }
          }, 1100);
        }

        /**
         * 判断点击目标是否属于交互元素
         * 避免点击链接/按钮/输入框时也飘字，干扰正常操作
         */
        function isInteractive(target) {
          if (!target || !(target instanceof Element)) return false;
          var tag = target.tagName.toLowerCase();
          if (tag === "a" || tag === "button" || tag === "input" ||
              tag === "textarea" || tag === "select" || tag === "label" ||
              tag === "summary") return true;
          if (target.closest("a, button, [role=button], input, textarea, select")) {
            return true;
          }
          // 排除特效容器自身（虽然它 pointer-events: none 不会收到事件，保险起见）
          if (target.closest(".char-trail")) return true;
          return false;
        }

        /**
         * 点击事件统一入口
         */
        function onClick(e) {
          // 交互元素跳过
          if (isInteractive(e.target)) return;

          // 从事件取坐标（触屏优先 changedTouches）
          var cx = 0, cy = 0;
          if (e.changedTouches && e.changedTouches[0]) {
            cx = e.changedTouches[0].clientX;
            cy = e.changedTouches[0].clientY;
          } else {
            cx = e.clientX;
            cy = e.clientY;
          }
          emitChar(cx, cy);
        }

        /** 启动 */
        function start() {
          container = document.getElementById("charTrail");
          if (!container) return;
          // 用 click + touchend 覆盖桌面和触屏
          document.addEventListener("click", onClick, false);
          document.addEventListener("touchend", onClick, { passive: true });
        }

        /** 清理 */
        function cleanup() {
          document.removeEventListener("click", onClick);
          document.removeEventListener("touchend", onClick);
        }

        // DOM 就绪后初始化
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start, { once: true });
        } else {
          start();
        }

        // SPA 切换时清空残留粒子
        document.addEventListener("astro:page-load", function () {
          if (container) container.innerHTML = "";
        });

        // 页面隐藏时清空，避免回来一堆飘字
        document.addEventListener("visibilitychange", function () {
          if (document.hidden && container) container.innerHTML = "";
        });

        window.addEventListener("beforeunload", cleanup);
      })();
    </script>

    <!--
      樱花飘落背景层：自动持续生成粉色花瓣
      ------------------------------------------------------------
      实现要点：
      1. SVG 花瓣形状：五瓣 + 粉白径向渐变，水墨水彩感
      2. 定时生成：每 350~650ms 一朵，位置/大小/速度全随机
      3. CSS 驱动动画：JS 只负责注入随机参数，下落/摇摆/旋转全在 CSS keyframes
      4. 同屏上限：DESKTOP 28 / 触屏 14，防止低端机卡顿
      5. 生命周期：visibilitychange 暂停恢复 / page-load 清空重建 / SPA 切换兼容
      6. 尊重 prefers-reduced-motion：仅首屏同时放固定少量花瓣，不循环生成
    -->
    <script is:inline data-sakura>
      (function () {
        "use strict";

        // ===== 配置 =====
        var PETAL_SVG =
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">' +
          '<defs>' +
          '<radialGradient id="sg" cx="50%" cy="35%" r="65%">' +
          '<stop offset="0%"  stop-color="#ffffff" stop-opacity="0.95"/>' +
          '<stop offset="55%" stop-color="#ffc1d1" stop-opacity="0.85"/>' +
          '<stop offset="100%" stop-color="#e88aa6" stop-opacity="0.7"/>' +
          '</radialGradient>' +
          '</defs>' +
          '<g fill="url(#sg)" stroke="#d87a95" stroke-width="0.5" stroke-opacity="0.35">' +
          '<!-- 5 片花瓣（椭圆 + 尖） -->' +
          '<ellipse cx="20" cy="6"  rx="5" ry="9" transform="rotate(  0 20 20)"/>' +
          '<ellipse cx="20" cy="6"  rx="5" ry="9" transform="rotate( 72 20 20)"/>' +
          '<ellipse cx="20" cy="6"  rx="5" ry="9" transform="rotate(144 20 20)"/>' +
          '<ellipse cx="20" cy="6"  rx="5" ry="9" transform="rotate(216 20 20)"/>' +
          '<ellipse cx="20" cy="6"  rx="5" ry="9" transform="rotate(288 20 20)"/>' +
          '<circle cx="20" cy="20" r="3.2" fill="#ff9fb4" fill-opacity="0.9" stroke="#d87a95" stroke-width="0.4"/>' +
          '</g>' +
          '</svg>';

        var MAX_PETALS_DESKTOP = 28;
        var MAX_PETALS_MOBILE = 14;
        var SPAWN_MIN = 350;   // 最短生成间隔 ms
        var SPAWN_MAX = 650;   // 最长生成间隔 ms
        var SIZE_MIN = 10;     // 花瓣大小下限 px
        var SIZE_MAX = 22;     // 花瓣大小上限 px
        var DUR_MIN = 7;       // 下落时长下限 s
        var DUR_MAX = 12;      // 下落时长上限 s
        var SWAY_MIN = 15;     // 水平摇摆下限 px
        var SWAY_MAX = 55;     // 水平摇摆上限 px

        // ===== 状态 =====
        var container = null;
        var spawnTimer = null;
        var maxPetals = MAX_PETALS_DESKTOP;

        /** 随机数 */
        function rand(min, max) {
          return Math.random() * (max - min) + min;
        }

        /** 当前设备判断 */
        function isMobile() {
          return (window.innerWidth < 640) ||
            (window.matchMedia && window.matchMedia("(pointer: coarse)").matches);
        }

        /** 是否尊重 reduced-motion */
        function prefersReducedMotion() {
          return window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        }

        /** 生成一朵花瓣 */
        function spawnPetal() {
          if (!container) return;

          // 数量上限保护
          if (container.children.length >= maxPetals) return;

          var el = document.createElement("div");
          el.className = "sakura-petal";
          el.innerHTML = PETAL_SVG;

          var size = rand(SIZE_MIN, SIZE_MAX);
          var leftPct = rand(0, 100);            // 水平起点百分比
          var sway = rand(SWAY_MIN, SWAY_MAX) * (Math.random() < 0.5 ? -1 : 1);
          var rot = rand(-180, 180);
          var dur = rand(DUR_MIN, DUR_MAX);
          var delay = rand(0, 2);                // 起始延迟，模拟不同时刻落下
          var fallDist = window.innerHeight + 80;

          el.style.setProperty("--sakura-size", size + "px");
          el.style.setProperty("--sakura-left", leftPct + "%");
          el.style.setProperty("--sakura-x", sway + "px");
          el.style.setProperty("--sakura-r", rot + "deg");
          el.style.setProperty("--sakura-d", fallDist + "px");
          el.style.setProperty("--sakura-dur", dur + "s");
          el.style.setProperty("--sakura-delay", delay + "s");

          container.appendChild(el);

          // 动画结束后清理（加 1s 余量）
          setTimeout(function () {
            if (el.parentNode === container) {
              container.removeChild(el);
            }
          }, (dur + delay) * 1000 + 1000);
        }

        /** 循环生成 */
        function scheduleSpawn() {
          if (!container) return;
          spawnPetal();
          var next = rand(SPAWN_MIN, SPAWN_MAX);
          spawnTimer = setTimeout(scheduleSpawn, next);
        }

        /** 启动 */
        function start() {
          container = document.getElementById("sakuraBg");
          if (!container) return;

          // 根据设备能力调整
          maxPetals = isMobile() ? MAX_PETALS_MOBILE : MAX_PETALS_DESKTOP;

          if (prefersReducedMotion()) {
            // reduced-motion: 只放 8 朵静止花瓣，不循环
            for (var i = 0; i < 8; i++) {
              spawnPetal();
            }
            return;
          }

          // 启动循环
          scheduleSpawn();
        }

        /** 停止 */
        function stop() {
          if (spawnTimer) {
            clearTimeout(spawnTimer);
            spawnTimer = null;
          }
        }

        /** 清空容器 */
        function clearAll() {
          if (container) container.innerHTML = "";
        }

        // DOM 就绪后启动
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start, { once: true });
        } else {
          start();
        }

        // 页面隐藏 → 暂停生成（已在飞的继续），恢复 → 继续
        document.addEventListener("visibilitychange", function () {
          if (document.hidden) {
            stop();
          } else {
            scheduleSpawn();
          }
        });

        // SPA 页面切换：清空残留，重新启动
        document.addEventListener("astro:page-load", function () {
          clearAll();
          stop();
          start();
        });

        // 窗口尺寸变化：重新判断是否是移动端
        window.addEventListener("resize", function () {
          var newMax = isMobile() ? MAX_PETALS_MOBILE : MAX_PETALS_DESKTOP;
          if (newMax !== maxPetals) {
            maxPetals = newMax;
          }
        });

        window.addEventListener("beforeunload", function () {
          stop();
          clearAll();
        });
      })();
    </script>
  </body>
</html>
