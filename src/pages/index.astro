---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconScroll from "@/assets/icons/IconScroll.svg";
import IconBrush from "@/assets/icons/IconBrush.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconWave from "@/assets/icons/IconWave.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      {/* 标题两侧竖界栏线（古籍界格意象）+ 印章小点缀 + 水墨挥手小手 */}
      <div class="my-4 flex items-center gap-3 sm:my-8">
        <span
          class="bg-accent/70 inline-block h-8 w-[3px] rounded-full sm:h-10"
          aria-hidden="true"></span>
        <h1
          class="inline-flex items-center gap-2 text-4xl font-bold sm:text-5xl"
        >
          你好
          <IconWave
            class="stroke-accent inline-block size-8 sm:size-10"
            aria-hidden="true"
          />
        </h1>
        <span
          class="bg-accent/70 inline-block h-8 w-[3px] rounded-full sm:h-10"
          aria-hidden="true"></span>
      </div>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        一间工作室，是专注国风周边、BJD 娃衣与平面设计的创作站点。本站追求简洁清爽的阅读体验，完美适配手机、电脑各类设备。自带深浅两套显示模式，同时支持自定义主题配色。
      </p>
      <p class="mt-2">
        浏览{" "}
        <LinkButton
          class="ink-underline text-accent"
          href={getRelativeLocaleUrl(locale, "posts")}
        >
          <IconScroll class="inline-block size-4" aria-hidden="true" />
          作品案例
        </LinkButton>
        ，或查阅{" "}
        <LinkButton
          class="ink-underline text-accent"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          <IconBrush class="inline-block size-4" aria-hidden="true" />
          项目说明
        </LinkButton>{" "}
        了解更多。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        class="ink-underline"
        href={getRelativeLocaleUrl(locale, "posts")}
      >
        <IconArchive class="inline-block size-4" aria-hidden="true" />
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
