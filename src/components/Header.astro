---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSeal from "@/assets/icons/IconSeal.svg";
import IconPalette from "@/assets/icons/IconPalette.svg";
import IconChevronDown from "@/assets/icons/IconChevronDown.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// 作品集下拉：两个子项分别汇集带有对应标签的文章。
// “娃衣”→ 标签「娃衣效果图」；“原创效果图”→ 标签「设计效果图」。
const worksItems = [
  { label: t.nav.worksDoll, tag: "娃衣效果图" },
  { label: t.nav.worksDesign, tag: "设计效果图" },
].map(item => ({
  label: item.label,
  href: getRelativeLocaleUrl(locale, `tags/${slugifyStr(item.tag)}/`),
}));
// 当前若处于 /tags 或 /works 下，作品集入口高亮。
const isWorksActive = isActive("/tags") || isActive("/works");
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="nav-hairline bg-background/70 sticky top-0 z-40 w-full backdrop-blur-md backdrop-saturate-150"
>
  <div
    class="app-layout relative flex flex-col items-center justify-between sm:flex-row"
  >
    <div
      class="relative flex w-full items-baseline justify-between py-4 sm:items-center sm:py-6"
    >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
    >
      {site.title}
    </a>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-accent mt-4 hidden w-44 grid-cols-2 place-content-center gap-2 sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0 sm:[&>li]:h-8 [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium sm:[&>li>a]:px-2 sm:[&>li>a]:py-1"
      >
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
          >
            {t.nav.posts}
          </a>
        </li>
        {/* 作品展示：独立作品汇总页，按分类展示所有原创设计 */}
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "works")}
            class:list={{ "active-nav": isActive("/works") }}
          >
            {t.nav.worksShowcase}
          </a>
        </li>
        {/* 作品集：点击展开下拉，子项按标签汇集作品（娃衣 / 原创效果图） */}
        <li class="col-span-2 sm:relative">
          <div class="works-dropdown relative">
            <button
              id="works-btn"
              type="button"
              class:list={[
                "focus-outline hover:text-accent flex w-full items-center justify-center gap-1 font-medium",
                "px-4 py-3 sm:px-2 sm:py-1",
                { "active-nav": isWorksActive },
              ]}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="works-menu"
            >
              {t.nav.works}
              <IconChevronDown
                class="works-caret size-4 transition-transform duration-200"
                aria-hidden="true"
              />
            </button>
            <div
              id="works-menu"
              class:list={[
                "works-menu t-dropdown",
                // 桌面端浮层：绝对定位小卡片；移动端内联展开、居中
                "sm:border-border sm:bg-background/95 sm:absolute sm:end-1/2 sm:z-50 sm:mt-2 sm:w-32 sm:translate-x-1/2 sm:rounded-md sm:border sm:p-1 sm:shadow-lg sm:backdrop-blur-md",
                "mt-1 flex flex-col gap-1",
              ]}
              data-origin="top-center"
              role="menu"
              aria-labelledby="works-btn"
            >
              {
                worksItems.map(item => (
                  <a
                    href={item.href}
                    role="menuitem"
                    class="hover:text-accent sm:hover:bg-muted block rounded px-4 py-2 text-center text-sm sm:px-2 sm:py-1.5 sm:text-start"
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </li>
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={{ "active-nav": isActive("/tags") }}
          >
            {t.nav.tags}
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
          >
            {t.nav.about}
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "time")}
            class:list={{ "active-nav": isActive("/time") }}
          >
            {t.nav.time}
          </a>
        </li>
        {
          features.showArchives && (
            <li class="col-span-2">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline flex size-full justify-center p-3 sm:relative sm:size-8 sm:p-0",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive class="hidden sm:absolute sm:top-1/2 sm:left-1/2 sm:block sm:size-6 sm:-translate-x-1/2 sm:-translate-y-1/2" />
                <span class="sm:sr-only">{t.nav.archives}</span>
                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="scale-125 max-sm:hidden sm:absolute sm:bottom-0 sm:w-6"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="col-span-1 flex items-center justify-center">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={["focus-outline relative size-8"]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.search}</span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125 max-sm:inset-s-2"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline hover:[&>.t-icon-swap]:stroke-accent relative size-12 p-4 sm:size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                {/* Icon swap 容器：两个图标交叉淡入淡出，带 blur + scale 过渡 */}
                <span
                  id="theme-icon-swap"
                  class="t-icon-swap absolute top-[50%] left-[50%] size-6 -translate-x-1/2 -translate-y-1/2"
                  data-state="a"
                >
                  <IconSeal class="t-icon" data-icon="a" />
                  <IconMoon class="t-icon" data-icon="b" />
                </span>
              </button>
            </li>
          )
        }
        {/* 国风预设配色选择器：与明暗切换相互独立，点开弹出四套配色色块 */}
        <li class="col-span-1 flex items-center justify-center">
          <div class="relative">
            <button
              id="palette-btn"
              class="focus-outline hover:[&>svg]:stroke-accent relative size-12 p-4 sm:size-8"
              title={t.a11y.togglePalette}
              aria-label={t.a11y.togglePalette}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="palette-menu"
            >
              <IconPalette class="absolute top-[50%] left-[50%] translate-[-50%]" />
            </button>
            <div
              id="palette-menu"
              class="border-border bg-background t-dropdown absolute end-0 z-50 mt-2 w-40 rounded-md border p-2 shadow-lg"
              data-origin="top-right"
              role="menu"
              aria-labelledby="palette-btn"
            >
              <button
                type="button"
                class="palette-option focus-outline hover:bg-muted flex w-full items-center gap-2 rounded px-2 py-1.5 text-start text-sm"
                data-palette="paper"
                data-mode="light"
                role="menuitem"
              >
                <span
                  class="inline-block size-4 rounded-full border border-black/20"
                  style="background:#f7f3ea"
                />
                <span>宣纸白</span>
              </button>
              <button
                type="button"
                class="palette-option focus-outline hover:bg-muted flex w-full items-center gap-2 rounded px-2 py-1.5 text-start text-sm"
                data-palette="ink"
                data-mode="dark"
                role="menuitem"
              >
                <span
                  class="inline-block size-4 rounded-full border border-black/20"
                  style="background:#1c2724"
                />
                <span>墨青</span>
              </button>
              <button
                type="button"
                class="palette-option focus-outline hover:bg-muted flex w-full items-center gap-2 rounded px-2 py-1.5 text-start text-sm"
                data-palette="lotus"
                data-mode="light"
                role="menuitem"
              >
                <span
                  class="inline-block size-4 rounded-full border border-black/20"
                  style="background:#f6f0f5"
                />
                <span>藕荷紫</span>
              </button>
              <button
                type="button"
                class="palette-option focus-outline hover:bg-muted flex w-full items-center gap-2 rounded px-2 py-1.5 text-start text-sm"
                data-palette="celadon"
                data-mode="light"
                role="menuitem"
              >
                <span
                  class="inline-block size-4 rounded-full border border-black/20"
                  style="background:#edf3f0"
                />
                <span>青瓷蓝</span>
              </button>
              <div class="border-border my-1 border-t" />
              <button
                type="button"
                class="palette-option focus-outline hover:bg-muted flex w-full items-center gap-2 rounded px-2 py-1.5 text-start text-sm"
                data-palette=""
                role="menuitem"
              >
                <span
                  class="inline-block size-4 rounded-full border border-black/20 bg-gradient-to-br from-white to-slate-700"
                />
                <span>默认主题</span>
              </button>
            </div>
          </div>
        </li>
      </ul>
    </nav>
    </div>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  // 关闭"作品集"下拉：用 t-dropdown 的 is-closing 做关闭动画，
  // --dropdown-close-dur 后再彻底隐藏。
  let _worksCloseTimer: ReturnType<typeof setTimeout> | null = null;
  function closeWorksMenu() {
    const btn = document.querySelector("#works-btn");
    const menu = document.querySelector<HTMLElement>("#works-menu");
    if (!menu) return;
    if (menu.classList.contains("is-open")) {
      menu.classList.remove("is-open");
      menu.classList.add("is-closing");
      if (_worksCloseTimer) clearTimeout(_worksCloseTimer);
      _worksCloseTimer = setTimeout(() => {
        menu?.classList.remove("is-closing");
      }, 160);
    }
    btn?.setAttribute("aria-expanded", "false");
    btn?.querySelector(".works-caret")?.classList.remove("rotate-180");
  }

  // 绑定“作品集”下拉的点击展开/收起。
  function toggleWorksMenu() {
    const btn = document.querySelector<HTMLButtonElement>("#works-btn");
    const menu = document.querySelector<HTMLElement>("#works-menu");
    const caret = btn?.querySelector(".works-caret");
    if (!btn || !menu) return;

    const closeMs = 160; // --dropdown-close-dur + 10ms 余量

    btn.addEventListener("click", event => {
      event.stopPropagation();
      const isOpen = menu.classList.contains("is-open");

      if (isOpen) {
        menu.classList.remove("is-open");
        menu.classList.add("is-closing");
        btn.setAttribute("aria-expanded", "false");
        caret?.classList.remove("rotate-180");
        if (_worksCloseTimer) clearTimeout(_worksCloseTimer);
        _worksCloseTimer = setTimeout(() => {
          menu?.classList.remove("is-closing");
        }, closeMs);
      } else {
        if (_worksCloseTimer) {
          clearTimeout(_worksCloseTimer);
          _worksCloseTimer = null;
        }
        menu.classList.remove("is-closing");
        menu.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
        caret?.classList.add("rotate-180");
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);

  toggleWorksMenu();
  document.addEventListener("astro:after-swap", toggleWorksMenu);

  // 点击下拉外部区域时收起（全局仅绑定一次）。
  if (!(window as unknown as { __worksBound?: boolean }).__worksBound) {
    (window as unknown as { __worksBound?: boolean }).__worksBound = true;
    document.addEventListener("click", event => {
      const menu = document.querySelector("#works-menu");
      const btn = document.querySelector("#works-btn");
      if (!menu || !menu.classList.contains("is-open")) return;
      const target = event.target as Node;
      if (!menu.contains(target) && !btn?.contains(target)) closeWorksMenu();
    });
    // Esc 键收起下拉。
    document.addEventListener("keydown", event => {
      if (event.key === "Escape") closeWorksMenu();
    });
  }
</script>
