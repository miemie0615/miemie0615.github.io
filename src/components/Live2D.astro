---
/**
 * 洛天依 Live2D 看板娘
 *
 * 模型来源：用户提供的 luotianyi-live2d-master（Cubism 2.0 / .moc）
 * Core：官方 Cubism 2.0 Live2DFramework（live2d.js）
 *
 * 结构：
 *   public/live2d/
 *   ├── js/live2d.js          ← 官方 core（已打包好）
 *   ├── model/tianyi/
 *   │   ├── model.json        ← 转换自 model.json.php
 *   │   ├── model.moc
 *   │   ├── motions/*.mtn     ← 28 个动作
 *   │   └── textures/1.png
 *
 * 特点：
 *   - 纯官方 core，零额外依赖
 *   - 点击头/身体触发对应动作（flick_head / tap_body）
 *   - 右键互动、切换显示/隐藏
 *   - 移动端自动隐藏
 *   - 延迟加载（requestIdleCallback）不阻塞首屏
 *
 * 关于 live2d.js 的 API：
 *   window.loadlive2d(canvasId, modelJsonPath, scale, offsetX, offsetY)
 *   - canvasId   : 元素 id
 *   - modelJsonPath : model.json 的 URL
 *   - scale      : 缩放比例（建议 1.0~1.5）
 *   - offsetX/Y  : 模型中心的偏移（0,0 居中）
 *
 *   它在内部用 XHR 加载 .moc / .mtn / texture，同域下自动跨域 OK。
 *   模型加载好之后，自动挂好 click/move 事件处理（tapEvent/mouseMove 等），
 *   直接 requestAnimationFrame 循环重绘，不需要我们再做。
 */
---

<!-- 场景容器：fixed 左下角，包裹 canvas + 气泡（不含切换按钮） -->
<div class="live2d-scene" id="live2dScene">

  <!-- canvas 必须预先确定好宽高，core 用 getContext("webgl", {premultipliedAlpha:true}) 来渲染 -->
  <canvas
    id="live2dcanvas"
    width="280"
    height="250"
    class="live2d-canvas"
    aria-hidden="true"
  ></canvas>

  <!-- 提示气泡 -->
  <div id="live2d-tips" class="live2d-tips"></div>
</div>

<!-- 显示/隐藏按钮：独立 fixed 元素，不跟着 scene 一起隐藏
     隐藏后仍可见 → 用来把天依叫出来 -->
<button id="live2d-toggle" class="live2d-toggle" title="显示/隐藏洛天依">
  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
    <!-- 默认：向下箭头（天依可见时，点=隐藏） -->
    <path id="live2d-toggle-icon" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
  </svg>
</button>

<!-- 注入官方 core（Cubism 2.0 Live2DFramework + Live2DModelWebGL） -->
<script is:inline src="/live2d/js/live2d.js"></script>

<script is:inline>
(function () {
  "use strict";

  var MODEL_JSON = "/live2d/model/tianyi/model.json";
  var CANVAS_ID = "live2dcanvas";
  var SCALE = 0.9;       // 缩小适配左下角的扁画布（280×250）
  var OFFSET_X = -15;    // 左偏，让天依整体居中（在扁画布里天依偏右）
  var OFFSET_Y = -20;    // 上移，让翅膀不被裁（画布偏矮）

  var hidden = false;
  var tipsTimer = null;
  var loaded = false;

  /** 显示气泡 */
  function showTips(text, timeout) {
    timeout = timeout || 3000;
    var el = document.getElementById("live2d-tips");
    if (!el) return;
    el.textContent = text;
    el.classList.add("live2d-tips-show");
    if (tipsTimer) clearTimeout(tipsTimer);
    tipsTimer = setTimeout(function () {
      el.classList.remove("live2d-tips-show");
    }, timeout);
  }

  /** 移动端判断 */
  function isMobile() {
    return window.matchMedia("(max-width: 768px)").matches;
  }

  /** 随机问候语 */
  function getGreeting() {
    var h = new Date().getHours();
    if (h < 6) return "夜深了，要注意身体哦~";
    if (h < 11) return "早上好！元气满满地出发吧~";
    if (h < 14) return "中午好，记得吃饭呀";
    if (h < 18) return "下午好，加油加油！";
    if (h < 22) return "晚上好~今天辛苦了";
    return "夜深了，早点休息吧";
  }

  /** 等待 live2d.js 加载好 */
  function waitCoreLoaded(cb) {
    // live2d.js 同步注入，一般在 DOMContentLoaded 前就加载好了
    if (typeof window.loadlive2d === "function") {
      cb();
      return;
    }
    var check = setInterval(function () {
      if (typeof window.loadlive2d === "function") {
        clearInterval(check);
        cb();
      }
    }, 80);
  }

  /** 真正加载模型 */
  function loadModel() {
    waitCoreLoaded(function () {
      try {
        // 官方 API：loadlive2d(canvasId, modelJsonPath, scale, offsetX, offsetY)
        // 它内部会 fetch model.json，然后加载 moc/mtn/textures，
        // 自动开启 requestAnimationFrame 重绘循环
        window.loadlive2d(CANVAS_ID, MODEL_JSON, SCALE, OFFSET_X, OFFSET_Y);

        // 延迟一点点让模型初始化好再显示气泡
        setTimeout(function () {
          loaded = true;
          showTips("我是洛天依，请多关照~", 3500);
          setTimeout(function () {
            showTips(getGreeting(), 3500);
          }, 2000);
        }, 1200);
      } catch (err) {
        console.error("Live2D 模型加载失败:", err);
        showTips("模型加载失败，请刷新重试", 4000);
      }
    });
  }

  /** 让 canvas 跟随窗口 resize（和目标网站一致：280×250 扁画布） */
  function fitCanvas() {
    var canvas = document.getElementById(CANVAS_ID);
    if (!canvas) return;

    // 和 unsignedzhang.cn 一样：canvas 280×250 比例，固定尺寸不随窗口缩放
    canvas.width = 280;
    canvas.height = 250;

    var wrap = canvas.parentElement;
    if (wrap) {
      wrap.style.width = "280px";
      wrap.style.height = "250px";
    }
  }

  /** 绑定互动事件
   *  用 cloneNode 彻底清掉 tips 元素上**所有**残留的事件监听器
   *  （防止调试脚本、astro HMR、或重复调用导致 listener 叠加），
   *  再在 window 上绑定我们自己的 click 处理（live2d.js 本身就在
   *  window 上监听 click，用同一层不会和它冲突）。
   *
   *  注意：**绝对不能 clone canvas**——live2d.js 内部持有原 canvas 的
   *  WebGL context 引用，clone 后会导致画面渲染在空白 canvas 上，
   *  而显示的是新 canvas（全黑）。
   */
  function bindExtraInteraction() {
    // === 清掉 tips 元素上的残留监听器（canvas 绝对不能 clone！） ===
    var tips = document.getElementById("live2d-tips");
    if (tips) {
      var fresh = tips.cloneNode(true);
      tips.parentNode.replaceChild(fresh, tips);
      fresh.id = "live2d-tips";
    }

    // 只绑定一次（astro:page-load 每次 SPA 切换会再次调用这个函数，
    //  但 _boundOnce 标记保证不会重复注册 window 级别的 click）
    if (bindExtraInteraction._boundOnce) return;
    bindExtraInteraction._boundOnce = true;

    function ourClickHandler(e) {
      if (hidden || !loaded) return;

      var pool = [
        "嗯~", "嘿嘿~", "好呀~", "唔？", "好开心！",
        "一起来玩吧！", "一间工作室，加油~",
        "想吃包子！", "来唱歌吧！"
      ];
      // 延迟 300ms：让 live2d.js 的 tapEvent 动作先触发，
      //  然后再显示气泡，视觉上"动作 → 说话"更自然
      setTimeout(function () {
        showTips(pool[Math.floor(Math.random() * pool.length)], 1800);
      }, 300);
    }

    // live2d.js 在 window 上监听 click（capture=false），
    //  我们也在 window 上监听但不 stopPropagation，
    //  两者互不干扰：它负责跑动作，我们负责飘气泡
    window.addEventListener("click", ourClickHandler);
  }

  /** 显示/隐藏
   *  scene（canvas + 气泡）会隐藏，但 toggle 按钮独立可见，
   *  且图标会切换：展开箭头（让你点=显示） ↔ 向下箭头（点=隐藏）
   */
  function setHidden(v) {
    hidden = v;
    var wrap = document.querySelector(".live2d-scene");
    var btn = document.getElementById("live2d-toggle");
    var icon = document.getElementById("live2d-toggle-icon");
    if (!wrap || !btn || !icon) return;

    if (hidden) {
      // 收起天依
      wrap.classList.add("live2d-hidden");
      localStorage.setItem("live2d_hidden", "1");
      // 按钮变小 + 图标变成展开箭头
      btn.classList.add("live2d-toggle-collapsed");
      icon.setAttribute("d", "M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z");
      btn.title = "显示洛天依";
    } else {
      // 展开天依
      wrap.classList.remove("live2d-hidden");
      localStorage.removeItem("live2d_hidden");
      // 按钮恢复 + 图标变回向下箭头
      btn.classList.remove("live2d-toggle-collapsed");
      icon.setAttribute("d", "M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z");
      btn.title = "隐藏洛天依";
      if (loaded) showTips("天依回来啦~", 2000);
    }
  }

  /** 启动 */
  function start() {
    if (isMobile()) {
      var wrap = document.querySelector(".live2d-scene");
      var btn = document.getElementById("live2d-toggle");
      if (wrap) wrap.style.display = "none";
      if (btn) btn.style.display = "none";
      return;
    }

    hidden = localStorage.getItem("live2d_hidden") === "1";
    if (hidden) {
      // 从 localStorage 恢复隐藏状态
      var wrap = document.querySelector(".live2d-scene");
      if (wrap) wrap.classList.add("live2d-hidden");
      // 同步按钮状态
      var btn = document.getElementById("live2d-toggle");
      var icon = document.getElementById("live2d-toggle-icon");
      if (btn) btn.classList.add("live2d-toggle-collapsed");
      if (icon) icon.setAttribute("d", "M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z");
    }

    fitCanvas();
    bindExtraInteraction();

    // 延迟加载，优先用 requestIdleCallback
    var doLoad = function () {
      loadModel();
    };
    if ("requestIdleCallback" in window) {
      requestIdleCallback(doLoad, { timeout: 3000 });
    } else {
      setTimeout(doLoad, 1500);
    }

    // 绑定显示/隐藏按钮
    var btn = document.getElementById("live2d-toggle");
    if (btn) {
      btn.addEventListener("click", function () {
        setHidden(!hidden);
      });
    }

    // 页面可见性
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) return;
      // 重新显示时，官方 core 的 RAF 会继续（因为 canvas 一直在 DOM 里）
    });

    // SPA 页面切换
    document.addEventListener("astro:page-load", function () {
      // 重新 fit + 重绑事件
      fitCanvas();
      bindExtraInteraction();
    });

    window.addEventListener("resize", fitCanvas);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
})();
</script>

<style is:global>
/* ============================================================
   场景容器：fixed 左下角（和 unsignedzhang.cn 一致：left:30px bottom:0）
   ============================================================ */
.live2d-scene {
  position: fixed;
  left: 30px;
  bottom: 0;
  z-index: 9999;
  user-select: none;
  transition: transform 0.35s ease, opacity 0.35s ease;
  pointer-events: auto;
}

.live2d-scene.live2d-hidden {
  opacity: 0;
  transform: scale(0.5) translateY(100px);
  pointer-events: none;
}

/* canvas：官方 core 内部用 WebGL 渲染，必须设置 width/height（JS 动态控制）
   去圆角，让天依在右下角无缝吸附 */
.live2d-canvas {
  display: block;
  border-radius: 0;
  /* 透明背景（premultipliedAlpha:true 已开启） */
  background: transparent;
  /* 柔和阴影，让天依不突兀 */
  filter: drop-shadow(0 4px 16px color-mix(in srgb, var(--accent) 18%, transparent));
}

/* ===== 气泡 ===== */
.live2d-tips {
  position: absolute;
  top: -36px;
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  background: var(--background);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 5px 12px;
  font-size: 12px;
  color: var(--foreground);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease, transform 0.25s ease;
  box-shadow: 0 4px 16px color-mix(in srgb, var(--foreground) 10%, transparent);
  z-index: 2;
}

.live2d-tips::after {
  content: "";
  position: absolute;
  bottom: -5px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 8px; height: 8px;
  background: var(--background);
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.live2d-tips.live2d-tips-show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ===== 显示/隐藏按钮：独立 fixed，跟着 scene 左下角
   天依可见时按钮在 canvas 右上角；天依隐藏时按钮变小、更靠左 */
.live2d-toggle {
  position: fixed;
  left: 286px;              /* scene 左下角 left:30px + canvas 宽 280px - 4px 对齐 */
  bottom: 246px;            /* scene bottom:0 + canvas 高 250px - 4px */
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--background);
  color: var(--foreground);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px color-mix(in srgb, var(--foreground) 12%, transparent);
  transition: transform 0.2s ease, left 0.35s ease, bottom 0.35s ease, opacity 0.35s ease;
  z-index: 10000;           /* 比 scene 的 9999 更高，确保永远可点 */
}
.live2d-toggle:hover { transform: scale(1.12); }

/* ===== 天依隐藏时：按钮缩小并归位到左下角 ===== */
.live2d-toggle.live2d-toggle-collapsed {
  width: 32px;
  height: 32px;
  left: 30px;               /* scene 原来的 left */
  bottom: 0;                /* scene 原来的 bottom */
  opacity: 0.85;
}
.live2d-toggle.live2d-toggle-collapsed:hover {
  transform: scale(1.15);
  opacity: 1;
}

/* ===== 深色模式微调 ===== */
html[data-theme="dark"] .live2d-canvas {
  filter: drop-shadow(0 4px 16px color-mix(in srgb, var(--accent) 12%, transparent));
}

/* ===== 响应式：移动端彻底隐藏 Live2D（包含 scene + toggle 按钮）===== */
@media (max-width: 768px) {
  .live2d-scene { display: none !important; }
  .live2d-toggle { display: none !important; }
}
</style>
