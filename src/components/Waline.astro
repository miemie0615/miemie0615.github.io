---
/**
 * Waline 评论系统组件
 * 基于 Waline（https://waline.js.org）的现代化评论系统
 *
 * 【工作原理】
 *   1. 通过 CDN 加载 Waline 客户端 CSS 和 JS
 *   2. 使用 init() 初始化评论区，传入后端 serverURL
 *   3. 支持暗色主题同步、SPA 路由切换
 *
 * 【依赖后端】
 *   Waline 需要独立部署后端服务
 *   可选数据库：Neon(PostgreSQL)、MongoDB、MySQL、SQLite
 *   部署方案详见 astro-paper.config.ts 注释
 *
 * 【使用条件】
 *   必须在 astro-paper.config.ts 的 features.waline 中配置 serverURL
 *   如果 waline 为 false 或未配置，组件会显示友好提示
 */
import config from "@/config";

// 读取 Waline 配置
const walineConfig = config.features.waline;
const isWalineEnabled = walineConfig !== false && typeof walineConfig === "object";

// 如果未启用，设置默认值用于模板渲染（不会真正初始化）
// 注意：lang 和 pageview 在 <script is:inline> 中通过模板字符串引用，
// TypeScript 编译器无法追踪，因此在模板属性中显式引用
const serverURL = isWalineEnabled ? walineConfig.serverURL : "";
const lang = isWalineEnabled ? (walineConfig.lang || "zh-CN") : "zh-CN";
const pageview = isWalineEnabled ? (walineConfig.pageview !== false) : false;
---

{isWalineEnabled ? (
  <>
    <!-- 
      Waline 预连接：提前建立与 CDN 和 Waline 后端的连接
      减少 CSS/JS 资源加载延迟
    -->
    <link rel="preconnect" crossorigin="anonymous" href="https://unpkg.com" />
    <link rel="preconnect" crossorigin="anonymous" href={serverURL} />

    <!-- Waline 样式（CDN 加载，支持主题切换） -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/@waline/client@v3/dist/waline.css"
    />

    <!-- 
      Waline 评论容器
      data-theme 用于 Waline 暗色主题识别
      data-lang 和 data-pageview 供 TypeScript 类型检查使用（实际值在脚本中读取）
    -->
    <div
      id="waline-container"
      class="waline my-8"
      data-theme="light"
      data-lang={lang}
      data-pageview={String(pageview)}
    >
      <!-- 加载提示 -->
      <div id="waline-loading" class="waline-loading">
        <div class="waline-spinner"></div>
        <span>评论区加载中…</span>
      </div>
    </div>

    <!-- 脚本部分放在后面 -->
    <script is:inline>
    (function () {
      "use strict";

      /* ============================================================
         Waline 配置（从全局配置读取）
         ============================================================ */
      var WALINE_SERVER_URL = serverURL;
      var WALINE_LANG = lang || "zh-CN";
      var ENABLE_PAGEVIEW = pageview !== false;

      var walineInstance = null;

      /* ============================================================
         获取当前网站主题
         ============================================================ */
      function getCurrentTheme() {
        var theme = document.documentElement.getAttribute("data-theme");
        if (theme === "dark") return "dark";
        return "light";
      }

      /* ============================================================
         同步主题到 Waline 容器
         Waline 通过父级 data-theme 属性判断暗色模式
         ============================================================ */
      function syncThemeToContainer() {
        var container = document.getElementById("waline-container");
        if (!container) return;
        container.setAttribute("data-theme", getCurrentTheme());
      }

      /* ============================================================
         监听主题变化（MutationObserver）
         ============================================================ */
      var themeObserver = null;
      function initThemeObserver() {
        if (themeObserver) return;
        themeObserver = new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            var m = mutations[i];
            if (m.type === "attributes" && m.attributeName === "data-theme") {
              syncThemeToContainer();
              if (walineInstance && walineInstance.update) {
                try {
                  walineInstance.update();
                } catch (e) {
                  // 忽略
                }
              }
            }
          }
        });
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
      }

      /* ============================================================
         显示/隐藏加载状态
         ============================================================ */
      function showLoading() {
        var container = document.getElementById("waline-container");
        if (!container) return;
        container.innerHTML =
          '<div id="waline-loading" class="waline-loading">' +
          '<div class="waline-spinner"></div>' +
          "<span>评论区加载中…</span>" +
          "</div>";
        container.setAttribute("data-theme", getCurrentTheme());
      }

      function showError(msg) {
        var container = document.getElementById("waline-container");
        if (!container) return;
        container.innerHTML =
          '<div id="waline-error" class="waline-error">' +
          "<p>" + (msg || "评论区加载失败，请稍后重试") + "</p>" +
          '<button id="waline-retry" class="waline-retry">重新加载</button>' +
          "</div>";
        var retryBtn = document.getElementById("waline-retry");
        if (retryBtn) {
          retryBtn.addEventListener("click", function () {
            initWaline();
          });
        }
      }

      /* ============================================================
         销毁旧实例（用于 SPA 路由切换）
         ============================================================ */
      function destroyWaline() {
        if (walineInstance && walineInstance.destroy) {
          try {
            walineInstance.destroy();
          } catch (e) {
            // 忽略
          }
          walineInstance = null;
        }
      }

      /* ============================================================
         初始化 Waline
         ============================================================ */
      function initWaline() {
        var container = document.getElementById("waline-container");
        if (!container) return;

        showLoading();
        syncThemeToContainer();

        // 动态导入 Waline 客户端模块
        import("https://unpkg.com/@waline/client@v3/dist/waline.js")
          .then(function (module) {
            var init = module.init;

            var options = {
              el: "#waline-container",
              serverURL: WALINE_SERVER_URL,
              lang: WALINE_LANG,
              path: window.location.pathname,
              dark: "html[data-theme='dark']",
              emoji: true,
              highlight: true,
              mathjax: false,
              katex: false,
              search: true,
              imageUploader: false,
              audioUploader: false,
              videoUploader: false,
              fileUploader: false,
            };

            walineInstance = init(options);
            syncThemeToContainer();
            initThemeObserver();
            container.style.opacity = "1";
          })
          .catch(function (err) {
            console.error("[Waline] 加载失败：", err);
            showError("评论服务加载失败，请检查网络后重试。");
          });
      }

      /* ============================================================
         处理 SPA 路由切换
         ============================================================ */
      function handlePageLoad() {
        destroyWaline();
        requestAnimationFrame(function () {
          var container = document.getElementById("waline-container");
          if (container) {
            container.style.opacity = "0";
            initWaline();
          }
        });
      }

      /* ============================================================
         页面浏览量统计（可选）
         ============================================================ */
      function initPageview() {
        if (!ENABLE_PAGEVIEW) return;
        import("https://unpkg.com/@waline/client@v3/dist/pageview.js")
          .then(function (module) {
            try {
              module.pageviewCount({
                serverURL: WALINE_SERVER_URL,
                path: window.location.pathname,
              });
            } catch (e) {
              // 静默失败
            }
          })
          .catch(function () {
            // 静默失败
          });
      }

      /* ============================================================
         启动
         ============================================================ */
      function start() {
        initWaline();
        initPageview();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start);
      } else {
        start();
      }

      // SPA 路由切换事件
      document.addEventListener("astro:page-load", handlePageLoad);
      document.addEventListener("astro:after-swap", handlePageLoad);
    })();
    </script>
  </>
) : (
  // Waline 未配置时的占位提示
  <div class="waline-disabled my-8 text-center text-sm text-muted-foreground">
    <p>评论系统未启用</p>
    <p class="mt-2">
      请在 <code>astro-paper.config.ts</code> 中配置
      <code>features.waline.serverURL</code> 以启用 Waline 评论
    </p>
  </div>
)}

<style>
  /* Waline 容器基础样式 */
  .waline {
    padding: 1rem 0;
    max-width: 100%;
    overflow-x: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* 加载提示 */
  .waline-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }

  .waline-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: waline-spin 0.8s linear infinite;
  }

  @keyframes waline-spin {
    to { transform: rotate(360deg); }
  }

  /* 错误提示 */
  .waline-error {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .waline-error p {
    margin-bottom: 1rem;
  }

  .waline-retry {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--accent);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--accent);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .waline-retry:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }
</style>