---
/**
 * Giscus 评论系统组件
 * 基于 GitHub Discussions 的免费评论系统
 * 支持跟随网站主题（浅色/深色）动态切换
 * 支持 SPA 路由切换后重新加载评论
 */

// Giscus 配置参数
const repo = "miemie0615/miemie0615.github.io";
const repoId = "R_kgDOUDSzOQ";
const category = "Announcements";
const categoryId = "DIC_kwDOUDSzOc4DERSo";
const mapping = "pathname";
const strict = "0";
const reactionsEnabled = "1";
const emitMetadata = "0";
const inputPosition = "bottom";
const lang = "zh-CN";
const loading = "lazy";

// 初始主题：延迟加载后从实际 DOM 状态读取
const defaultTheme = "light";
---

<!-- Giscus 评论容器 -->
<div id="giscus-container" class="giscus my-8"></div>

<script is:inline>
(function () {
  "use strict";

  var observer = null;
  var initialized = false;

  /* ============================================================
     获取当前网站主题
     ============================================================ */
  function getCurrentTheme() {
    var theme = document.documentElement.getAttribute("data-theme");
    if (theme === "dark") return "dark";
    return "light";
  }

  /* ============================================================
     发送主题切换消息给 Giscus iframe
     ============================================================ */
  function setGiscusTheme(theme) {
    var iframe = document.querySelector(".giscus-frame");
    if (!iframe || !iframe.contentWindow) return;

    var message = {
      config: {
        theme: theme === "dark" ? "dark" : "light",
      },
    };
    iframe.contentWindow.postMessage(message, "https://giscus.app");
  }

  /* ============================================================
     初始化主题同步（单次绑定 MutationObserver）
     ============================================================ */
  function initThemeObserver() {
    if (observer) return;

    observer = new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var mutation = mutations[i];
        if (
          mutation.type === "attributes" &&
          mutation.attributeName === "data-theme"
        ) {
          setGiscusTheme(getCurrentTheme());
        }
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  /* ============================================================
     销毁旧的 Giscus 实例（SPA 切换前清理）
     ============================================================ */
  function destroyGiscus() {
    // 移除 Giscus iframe
    var iframe = document.querySelector(".giscus-frame");
    if (iframe) iframe.remove();

    // 移除 Giscus 注入的 script
    var oldScript = document.querySelector(
      'script[src="https://giscus.app/client.js"]'
    );
    if (oldScript) oldScript.remove();

    // 清理容器
    var container = document.getElementById("giscus-container");
    if (container) container.innerHTML = "";
  }

  /* ============================================================
     重新加载 Giscus（SPA 路由切换后）
     ============================================================ */
  function reloadGiscus() {
    destroyGiscus();

    var container = document.getElementById("giscus-container");
    if (!container) return;

    // 创建新的 Giscus script 元素
    var script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.setAttribute("data-repo", repo);
    script.setAttribute("data-repo-id", repoId);
    script.setAttribute("data-category", category);
    script.setAttribute("data-category-id", categoryId);
    script.setAttribute("data-mapping", mapping);
    script.setAttribute("data-strict", strict);
    script.setAttribute("data-reactions-enabled", reactionsEnabled);
    script.setAttribute("data-emit-metadata", emitMetadata);
    script.setAttribute("data-input-position", inputPosition);
    script.setAttribute("data-theme", getCurrentTheme());
    script.setAttribute("data-lang", lang);
    script.setAttribute("data-loading", loading);
    script.setAttribute("crossorigin", "anonymous");
    script.async = true;

    container.appendChild(script);

    // 等待 Giscus iframe 加载完成后同步主题
    waitAndSyncTheme();
  }

  /* ============================================================
     等待 Giscus iframe 加载后同步主题
     ============================================================ */
  function waitAndSyncTheme() {
    var iframe = document.querySelector(".giscus-frame");
    if (iframe) {
      // 如果当前是深色主题，需要切换
      if (getCurrentTheme() === "dark") {
        setTimeout(function () {
          setGiscusTheme("dark");
        }, 500);
      }
      // 确保主题观察器已绑定
      initThemeObserver();
    } else {
      // Giscus 可能还在加载中，等待一小段时间
      setTimeout(waitAndSyncTheme, 300);
    }
  }

  /* ============================================================
     启动：首次加载 + SPA 事件监听
     ============================================================ */
  function start() {
    reloadGiscus();
    initialized = true;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }

  // SPA 路由切换后重新加载
  document.addEventListener("astro:page-load", function () {
    start();
  });

  // 兼容旧版本 View Transitions
  document.addEventListener("astro:after-swap", function () {
    start();
  });
})();
</script>

<style>
  .giscus {
    padding: 1rem 0;
    max-width: 100%;
    overflow-x: hidden;
  }
</style>
